# 로컬 Edge Function과 KMLA 제공자 등록 스크립트(`pnpm kmla:provider`)가 읽는 값.
# 같은 폴더에 `.env`로 복사해 채운다. `.env`는 커밋하지 않는다(.gitignore).
#
# 로컬 위키는 KMLA Online **dev 원격** 프로젝트를 OIDC 제공자로 쓴다. KMLA 로컬은 HS256 서명이라
# ID 토큰이 나오지 않고, 위키 auth 컨테이너에서 KMLA 로컬 주소에 닿기도 어렵다.

# KMLA Online dev 프로젝트 주소와 publishable key(공개 값).
KMLA_URL=https://trftjcieogrewqptgidd.supabase.co
KMLA_PUBLISHABLE_KEY=

# KMLA dev 대시보드 → Authentication → OAuth Apps의 "큼온 위키 (dev)".
KMLA_OAUTH_CLIENT_ID=
# 비밀 값. 제공자 등록 스크립트만 쓰고, 함수는 읽지 않는다.
KMLA_OAUTH_CLIENT_SECRET=

# 브라우저에서 `kmla-verify`를 부를 수 있는 위키 주소(쉼표로 구분).
WIKI_ORIGINS=http://127.0.0.1:5183,http://localhost:5183
