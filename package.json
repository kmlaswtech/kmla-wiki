{
  "name": "kmla-wiki",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc",
    "lint": "react-router typegen && oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache",
    "check": "react-router typegen && oxlint --type-aware --deny-warnings && tsc && vitest run",
    "verify": "react-router typegen && oxlint --type-aware --deny-warnings && tsc && vitest run && react-router build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db --local",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on error",
    "db:advisors": "supabase db advisors --local --type security --level warn --fail-on error",
    "db:types": "supabase gen types typescript --local > app/shared/supabase/database.types.ts && prettier --no-semi --ignore-path \"\" --log-level warn --write app/shared/supabase/database.types.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jsquash/webp": "^1.5.0",
    "@react-router/node": "^8",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.4",
    "heic-to": "^1.6.7",
    "isbot": "^5.2.2",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
